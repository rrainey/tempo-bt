menu "Tempo-BT Application"

config GNSS_TEST_MODE
	bool "Enable GNSS UBX communication test at boot"
	default n
	help
	  Run UBX protocol validation tests during GNSS initialization.
	  This sends test commands to the SAM-M10Q and verifies ACK/NAK
	  responses are received correctly. Useful for debugging
	  communication issues with the GNSS module.

config USE_MAG_IN_ORIENTATION
	bool "Use magnetometer in orientation AHRS"
	default n
	depends on MMC5983MA
	help
	  When enabled, the orientation service will read magnetometer
	  samples from the MMC5983MA sensor and feed them to the Fusion
	  AHRS algorithm for improved heading accuracy. This provides
	  absolute heading reference but requires magnetometer calibration.

	  When disabled, the AHRS operates in IMU-only mode using
	  gyroscope and accelerometer data. Heading will drift over time
	  but is immune to magnetic interference.

config USB_TTY_OUTPUT
	bool "Enable USB CDC-ACM TTY output for ground testing"
	default y
	depends on USB_DEVICE_STACK && USB_CDC_ACM
	help
	  Long press BTN1 to stream sensor/NMEA data over USB serial
	  when a USB host is connected. Ground test mode only.

endmenu

# Include project-specific drivers
rsource "drivers/Kconfig"

source "Kconfig.zephyr"
